#!/usr/bin/env bash
# Put both passwords back to their defaults (site: root, setup Wi-Fi: rootroot).
# The running app notices within a few seconds and signs everyone out.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
F=/etc/walloftext/passwords.txt
install -d -m 0750 -o walloftext -g walloftext /etc/walloftext
TMP="$(mktemp /etc/walloftext/.passwords.XXXXXX)"
cat > "$TMP" <<'EOF'
# Wall of Text passwords. Plain text on purpose: edit this file, or use Settings > Access.
# Changes apply straight away. No restart needed.
gui_password=root
setup_wifi_password=rootroot
EOF
chown walloftext:walloftext "$TMP"
chmod 0600 "$TMP"
mv -f "$TMP" "$F"
[[ "${1:-}" == --quiet ]] || echo "Passwords reset: site password 'root', setup Wi-Fi password 'rootroot'."
