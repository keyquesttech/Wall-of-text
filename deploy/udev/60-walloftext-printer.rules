# Thermal printer: stable name /dev/walloftext-printer, group lp.
# Phase 0: the printer is a Gprinter CSN-A4, USB 0fe6:811e, on /dev/usb/lp0.
# The match stays generic (any USB printer-class node) so a replacement printer also works.
SUBSYSTEM=="usbmisc", KERNEL=="lp[0-9]*", GROUP="lp", MODE="0660", SYMLINK+="walloftext-printer"
